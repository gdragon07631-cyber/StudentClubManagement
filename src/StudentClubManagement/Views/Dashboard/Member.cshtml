@model StudentClubManagement.ViewModels.DashboardViewModel
@{ ViewData["Title"] = "Trang chủ thành viên"; }
<section class="hero-card"><div><span class="hero-kicker">Khu vực thành viên</span><h1>Chào @Model.DisplayName!</h1><p>Bạn có <strong>@Model.OpenTasks nhiệm vụ</strong> đang mở và <strong>@Model.UnreadNotifications thông báo</strong> chưa đọc.</p></div><a class="btn btn-icon" asp-controller="ClubTasks"><svg><use href="#i-check"/></svg>Xem việc cần làm</a></section>
<section class="metric-grid">
    <a class="metric-card surface" asp-controller="Points"><span class="metric-icon"><svg><use href="#i-star"/></svg></span><div class="metric-label">Điểm hoạt động</div><div class="metric-value">@Model.Points.ToString("N0") <small>điểm</small></div><div class="metric-note">Tổng từ lịch sử điểm của bạn</div></a>
    <a class="metric-card surface" asp-controller="ClubTasks"><span class="metric-icon"><svg><use href="#i-check"/></svg></span><div class="metric-label">Nhiệm vụ đang làm</div><div class="metric-value">@Model.OpenTasks <small>nhiệm vụ</small></div><div class="metric-note">Tiến độ dưới 100%</div></a>
    <a class="metric-card surface" asp-controller="Activities"><span class="metric-icon"><svg><use href="#i-calendar"/></svg></span><div class="metric-label">Sự kiện hiện có</div><div class="metric-value">@Model.Activities <small>sự kiện</small></div><div class="metric-note">Xem và đăng ký trong module hoạt động</div></a>
    <a class="metric-card surface" asp-controller="Notifications"><span class="metric-icon"><svg><use href="#i-bell"/></svg></span><div class="metric-label">Thông báo mới</div><div class="metric-value">@Model.UnreadNotifications <small>chưa đọc</small></div><div class="metric-note">Dành riêng cho tài khoản của bạn</div></a>
</section>
<div class="dashboard-grid">
    <div class="stack">
        <section class="surface section-card"><div class="section-heading"><div><h2>Nhiệm vụ của tôi</h2><p>Tiến độ công việc được người quản lý phân công.</p></div><a class="section-link" asp-controller="ClubTasks">Xem tất cả</a></div>@if (Model.MyTasks.Any()) { @foreach (var task in Model.MyTasks.Take(4)) { <article class="task-item"><div class="task-top"><div><span class="status-badge @(task.Progress >= 100 ? "success" : task.Priority == "HIGH" ? "danger" : "primary")">@task.Status</span><div class="task-title">@task.Title</div><div class="task-meta">Hạn: @(task.DueDate?.ToString("dd/MM/yyyy") ?? "Chưa đặt") · @task.Priority</div></div><strong>@task.Progress%</strong></div><div class="progress-label"><span>Tiến độ thực hiện</span><span>@task.Progress%</span></div><div class="progress"><div class="progress-bar" style="width:@task.Progress%"></div></div></article> } } else { <div class="empty-state">Bạn chưa có nhiệm vụ được phân công.</div> }</section>
        <section class="surface section-card"><div class="section-heading"><div><h2>Sự kiện &amp; hoạt động sắp diễn ra</h2><p>Đăng ký tham gia trong module Hoạt động.</p></div><a class="section-link" asp-controller="Activities">Xem hoạt động</a></div><div class="calendar-list">@foreach (var activity in Model.UpcomingActivities) { <article class="calendar-item success"><span class="status-badge success">@activity.Status</span><h3>@activity.ActivityName</h3><p>@activity.StartTime.ToString("dd/MM/yyyy HH:mm") · @(activity.Location ?? "Chưa có địa điểm")</p></article> } @if (!Model.UpcomingActivities.Any()) { <div class="empty-state">Chưa có hoạt động sắp tới.</div> }</div></section>
    </div>
    <aside class="stack dashboard-aside">
        <section class="surface section-card"><div class="section-heading no-border"><div><h2>Lịch họp &amp; Thông báo</h2><p>Dữ liệu mới nhất dành cho bạn.</p></div></div><div class="calendar-list">@foreach (var meeting in Model.UpcomingMeetings.Take(2)) { <article class="calendar-item"><span class="status-badge primary">Cuộc họp</span><h3>@meeting.Title</h3><p>@meeting.MeetingTime.ToString("dd/MM/yyyy HH:mm")</p></article> }</div><div class="notification-list">@foreach (var notice in Model.RecentNotifications) { <article class="notification-item"><span class="notification-dot"></span><div><strong>@notice.Title</strong><p>@notice.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")</p></div></article> }</div></section>
        <section class="surface ai-panel"><h2>Trợ lý CLB AI</h2><p>Hỏi về nhiệm vụ, điểm hoạt động hoặc nội dung cuộc họp trong phạm vi bạn được xem.</p><a class="btn" asp-controller="AI" asp-action="Chat">Hỏi Chatbot AI</a></section>
    </aside>
</div>
