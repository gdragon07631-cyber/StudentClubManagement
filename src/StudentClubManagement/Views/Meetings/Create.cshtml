@using StudentClubManagement.Models
@model Meeting
<h1>Tạo cuộc họp</h1><form method="post" class="card card-body"><div asp-validation-summary="All" class="text-danger"></div>@if(User.IsInRole(AppRoles.Admin)){<label asp-for="ClubId">Câu lạc bộ</label><select asp-for="ClubId" asp-items="ViewBag.Clubs" class="form-select mb-2"><option value="">-- Chọn câu lạc bộ --</option></select>}<label asp-for="Title">Tiêu đề</label><input asp-for="Title" class="form-control mb-2"/><label asp-for="MeetingTime">Thời gian</label><input asp-for="MeetingTime" class="form-control mb-2"/><label asp-for="Location">Địa điểm</label><input asp-for="Location" class="form-control mb-2"/><label asp-for="Agenda">Chương trình</label><textarea asp-for="Agenda" class="form-control mb-2"></textarea><label asp-for="Minutes">Biên bản</label><textarea asp-for="Minutes" class="form-control mb-2"></textarea><label asp-for="Decisions">Quyết định</label><textarea asp-for="Decisions" class="form-control mb-3"></textarea><button class="btn btn-primary">Lưu</button></form>
