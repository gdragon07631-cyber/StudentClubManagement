@using StudentClubManagement.Models
@using Microsoft.EntityFrameworkCore
@inject StudentClubManagement.Data.ApplicationDbContext Db
@model IEnumerable<Meeting>
@{ ViewData["Title"] = "Cuộc họp"; }
<header class="page-header"><div><div class="page-eyebrow">Lịch làm việc</div><h1 class="page-title">Cuộc họp</h1><p class="page-subtitle">Lịch họp, chương trình, biên bản và quyết định được lưu trong hệ thống.</p></div>@if(!User.IsInRole(AppRoles.Member)){<div class="page-actions"><a class="btn btn-primary btn-icon" asp-action="Create"><svg><use href="#i-plus"/></svg>Tạo lịch họp</a></div>}</header>
<form method="get" class="surface filter-card"><div class="row g-2"><div class="col-lg-5"><input name="q" value="@ViewBag.Query" class="form-control" placeholder="Tiêu đề hoặc địa điểm"/></div><div class="col-lg-3"><input name="status" value="@ViewBag.Status" class="form-control" placeholder="Trạng thái"/></div><div class="col-lg-2"><select name="sort" class="form-select"><option value="newest">Mới nhất</option><option value="title">Tên A-Z</option></select></div><div class="col"><button class="btn btn-primary w-100">Lọc</button></div></div></form>
<div class="stack">
@foreach(var x in Model){
    var attendances = Db.MeetingAttendance.Include(a => a.Member).Where(a => a.MeetingId == x.Id).ToList();
    var attendedIds = attendances.Select(a => a.MemberId).ToHashSet();
    var clubMembers = Db.Members.Where(m => m.ClubId == x.ClubId && m.MemberStatus == DomainStatus.Active).OrderBy(m => m.FullName).ToList();
    var unrecorded = clubMembers.Where(m => !attendedIds.Contains(m.Id)).ToList();
    <article class="surface p-4">
        <div class="d-flex justify-content-between align-items-start gap-3">
            <div>
                <span class="status-badge primary">@x.Status</span>
                <h2 class="h4 mt-3 mb-2">@x.Title</h2>
            </div>
            <span class="metric-icon"><svg><use href="#i-calendar"/></svg></span>
        </div>
        <div class="calendar-item">
            <strong>@x.MeetingTime.ToString("dd/MM/yyyy HH:mm")</strong>
            <p class="mt-1">@(x.Location ?? "Chưa có địa điểm")</p>
        </div>
        @if(!string.IsNullOrWhiteSpace(x.Agenda)){<p class="mt-3 mb-1"><strong>Chương trình:</strong> @x.Agenda</p>}
        @if(!string.IsNullOrWhiteSpace(x.Minutes)){<p class="mb-1"><strong>Biên bản:</strong> @x.Minutes</p>}
        @if(!string.IsNullOrWhiteSpace(x.Decisions)){<p class="mb-1"><strong>Quyết định:</strong> @x.Decisions</p>}
        @if(!User.IsInRole(AppRoles.Member)){
            <div class="d-flex gap-2 mt-3">
                <a class="btn btn-sm btn-light" asp-action="Edit" asp-route-id="@x.Id">Sửa / ghi biên bản</a>
            </div>
            <details class="mt-3 pt-2 border-top">
                <summary class="text-primary small" style="cursor:pointer; font-weight:600;">Điểm danh cuộc họp (@attendances.Count đã ghi)</summary>
                @if(unrecorded.Any() && x.Status != "CANCELLED"){
                    <form asp-action="Attendance" method="post" class="d-flex flex-wrap gap-2 mt-2 align-items-center">
                        <input type="hidden" name="id" value="@x.Id" />
                        <select name="memberId" class="form-select form-select-sm" style="max-width:200px" required>
                            <option value="">-- Chọn thành viên --</option>
                            @foreach(var m in unrecorded){
                                <option value="@m.Id">@m.FullName (@m.StudentCode)</option>
                            }
                        </select>
                        <select name="status" class="form-select form-select-sm" style="max-width:120px" required>
                            <option value="PRESENT">Có mặt</option>
                            <option value="LATE">Đi muộn</option>
                            <option value="ABSENT">Vắng mặt</option>
                        </select>
                        <button class="btn btn-sm btn-primary">Điểm danh</button>
                    </form>
                }
                @if(attendances.Any()){
                    <div class="small mt-2">
                        <ul class="list-unstyled mb-0">
                            @foreach(var att in attendances){
                                var attBadge = att.AttendanceStatus == "PRESENT" ? "success" : att.AttendanceStatus == "LATE" ? "warning" : "danger";
                                var attText = att.AttendanceStatus == "PRESENT" ? "Có mặt" : att.AttendanceStatus == "LATE" ? "Đi muộn" : "Vắng";
                                <li class="d-flex justify-content-between py-1 border-bottom">
                                    <span>@att.Member.FullName (@att.Member.StudentCode)</span>
                                    <span class="status-badge @attBadge">@attText</span>
                                </li>
                            }
                        </ul>
                    </div>
                }else{
                    <p class="text-muted small mt-2 mb-0">Chưa có bản ghi điểm danh nào.</p>
                }
            </details>
        }
    </article>
}
</div>
@if(!Model.Any()){<div class="surface empty-state">Chưa có cuộc họp phù hợp.</div>}

