@model StudentClubManagement.Models.ClubTask
<h1>Sửa nhiệm vụ</h1><form method="post" class="card card-body"><input asp-for="Id" type="hidden"/><div asp-validation-summary="All" class="text-danger"></div><label asp-for="Title">Tiêu đề</label><input asp-for="Title" class="form-control mb-2"/><label asp-for="Description">Mô tả</label><textarea asp-for="Description" class="form-control mb-2"></textarea><div class="row"><div class="col"><label asp-for="ActivityId">Hoạt động</label><select asp-for="ActivityId" asp-items="ViewBag.Activities" class="form-select"><option value="">Không</option></select></div><div class="col"><label asp-for="MeetingId">Cuộc họp</label><select asp-for="MeetingId" asp-items="ViewBag.Meetings" class="form-select"><option value="">Không</option></select></div></div><div class="row mt-2"><div class="col"><label asp-for="Priority">Ưu tiên</label><input asp-for="Priority" class="form-control"/></div><div class="col"><label asp-for="DueDate">Hạn</label><input asp-for="DueDate" class="form-control"/></div><div class="col"><label asp-for="Status">Trạng thái</label><input asp-for="Status" class="form-control"/></div></div><button class="btn btn-primary mt-3">Lưu thay đổi</button></form>
