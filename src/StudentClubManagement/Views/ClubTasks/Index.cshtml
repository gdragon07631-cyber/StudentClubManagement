@using StudentClubManagement.Models
@model IEnumerable<ClubTask>
@{ ViewData["Title"] = "Nhiệm vụ"; }
<header class="page-header"><div><div class="page-eyebrow">Quản lý công việc</div><h1 class="page-title">@(User.IsInRole(AppRoles.Member) ? "Nhiệm vụ của tôi" : "Nhiệm vụ CLB")</h1><p class="page-subtitle">Theo dõi phân công, thời hạn và tiến độ từ dữ liệu nhiệm vụ hiện có.</p></div>@if(!User.IsInRole(AppRoles.Member)){<div class="page-actions"><a class="btn btn-primary btn-icon" asp-action="Create"><svg><use href="#i-plus"/></svg>Tạo nhiệm vụ mới</a></div>}</header>
<form method="get" class="surface filter-card"><div class="row g-2"><div class="col-lg-5"><input name="q" value="@ViewBag.Query" class="form-control" placeholder="Tìm theo tiêu đề nhiệm vụ"/></div><div class="col-lg-3"><select name="status" class="form-select"><option value="">Mọi trạng thái</option><option value="OPEN">OPEN</option><option value="IN_PROGRESS">IN_PROGRESS</option><option value="COMPLETED">COMPLETED</option></select></div><div class="col-lg-2"><select name="sort" class="form-select"><option value="due">Hạn gần nhất</option><option value="title">Tên A-Z</option><option value="progress">Tiến độ cao</option></select></div><div class="col"><button class="btn btn-primary w-100">Lọc</button></div></div></form>
<section class="surface section-card"><div class="section-heading"><div><h2>Danh sách nhiệm vụ</h2><p>@Model.Count() nhiệm vụ trong phạm vi truy cập</p></div></div>@foreach(var x in Model){var badge=x.Progress>=100?"success":x.Priority=="HIGH"?"danger":x.Progress>0?"primary":"warning";<article class="task-item"><div class="task-top"><div><span class="status-badge @badge">@x.Priority · @x.Status</span><div class="task-title">@x.Title</div><div class="task-meta">Nguồn: @(x.Activity?.ActivityName ?? x.Meeting?.Title ?? "Nhiệm vụ độc lập") · Hạn: @(x.DueDate?.ToString("dd/MM/yyyy") ?? "Chưa đặt")</div><div class="task-meta mt-1">Phụ trách: @(x.Assignments.Any()?string.Join(", ",x.Assignments.Select(a=>a.Member.FullName)):"Chưa phân công")</div></div><strong>@x.Progress%</strong></div><div class="progress-label"><span>Tiến độ thực hiện</span><span>@x.Progress%</span></div><div class="progress"><div class="progress-bar" style="width:@x.Progress%"></div></div><div class="d-flex flex-wrap gap-2 mt-3">@if(User.IsInRole(AppRoles.Member)){<form asp-action="Progress" method="post" class="d-flex gap-2"><input type="hidden" name="id" value="@x.Id"/><input type="number" name="progress" min="0" max="100" value="@x.Progress" class="form-control form-control-sm"/><button class="btn btn-sm btn-primary">Cập nhật tiến độ</button></form>}else{<a class="btn btn-sm btn-light" asp-action="Edit" asp-route-id="@x.Id">Chỉnh sửa</a><form asp-action="Assign" method="post" class="d-flex gap-1"><input type="hidden" name="id" value="@x.Id"/><select name="memberId" asp-items="ViewBag.Members" class="form-select form-select-sm" required><option value="">Chọn thành viên</option></select><button class="btn btn-sm btn-primary">Phân công</button></form><form asp-controller="AI" asp-action="Recommend" method="post"><input type="hidden" name="taskId" value="@x.Id"/><button class="btn btn-sm btn-outline-primary">AI gợi ý</button></form>}</div></article>}@if(!Model.Any()){<div class="empty-state">Chưa có nhiệm vụ phù hợp.</div>}</section>
