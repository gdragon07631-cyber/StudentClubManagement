@model StudentClubManagement.Models.ClubTask
<h1>Tạo nhiệm vụ</h1><form method="post" class="card card-body"><div asp-validation-summary="All" class="text-danger"></div><label asp-for="Title">Tiêu đề</label><input asp-for="Title" class="form-control mb-2"/><label asp-for="Description">Mô tả</label><textarea asp-for="Description" class="form-control mb-2"></textarea><div class="row"><div class="col"><label asp-for="ActivityId">Hoạt động</label><select asp-for="ActivityId" asp-items="ViewBag.Activities" class="form-select"><option value="">-- Không --</option></select></div><div class="col"><label asp-for="MeetingId">Cuộc họp</label><select asp-for="MeetingId" asp-items="ViewBag.Meetings" class="form-select"><option value="">-- Không --</option></select></div></div><label asp-for="DueDate">Hạn</label><input asp-for="DueDate" class="form-control mb-3"/><button class="btn btn-primary">Lưu</button></form>
