@model StudentClubManagement.ViewModels.IssueAccountViewModel
@{ ViewData["Title"] = "Cấp tài khoản sinh viên"; }
<h1>Cấp tài khoản sinh viên</h1>
<p>Thành viên: <strong>@Model.FullName</strong></p>
@if (Model.ExistingUsername != null)
{
    <div class="alert alert-success">Đã cấp tài khoản: <strong>@Model.ExistingUsername</strong>. Mật khẩu không được hiển thị lại.</div>
}
else
{
    <form asp-action="IssueAccount" method="post" class="card card-body">
        <div asp-validation-summary="All" class="text-danger"></div>
        <input asp-for="Id" type="hidden" />
        <div class="mb-3"><label asp-for="Username"></label><input asp-for="Username" class="form-control" autocomplete="off" /></div>
        <div class="mb-3"><label asp-for="Password"></label><input asp-for="Password" class="form-control" autocomplete="new-password" /></div>
        <div class="mb-3"><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" /></div>
        <p>Mật khẩu có ít nhất 8 ký tự, gồm chữ hoa, chữ thường và chữ số. Hãy ghi nhớ mật khẩu để bàn giao trực tiếp cho sinh viên.</p>
        <button class="btn btn-primary">Cấp tài khoản thành viên</button>
    </form>
}
<a asp-action="Index" class="btn btn-link mt-3">Quay lại danh sách đơn</a>
