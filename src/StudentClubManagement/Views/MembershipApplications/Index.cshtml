@using StudentClubManagement.Models
@model IEnumerable<MembershipApplication>
@{ ViewData["Title"] = "Xét duyệt đơn đăng ký"; var total = Model.Count(); var pending = Model.Count(x => x.Status == "PENDING"); var approved = Model.Count(x => x.Status == "APPROVED"); var rejected = Model.Count(x => x.Status == "REJECTED"); }
<header class="page-header"><div><div class="page-eyebrow">Quản lý câu lạc bộ · Đơn đăng ký</div><h1 class="page-title">Xét duyệt đơn đăng ký thành viên</h1><p class="page-subtitle">Admin xem tất cả; Trưởng câu lạc bộ chỉ xử lý đơn thuộc câu lạc bộ của mình.</p></div></header>
<section class="metric-grid">
    <div class="metric-card surface"><span class="metric-icon"><svg><use href="#i-clipboard"/></svg></span><div class="metric-label">Tổng số đơn</div><div class="metric-value">@total <small>hồ sơ</small></div></div>
    <div class="metric-card surface"><span class="metric-icon"><svg><use href="#i-calendar"/></svg></span><div class="metric-label">Chờ xét duyệt</div><div class="metric-value">@pending <small>đang chờ</small></div></div>
    <div class="metric-card surface"><span class="metric-icon"><svg><use href="#i-check"/></svg></span><div class="metric-label">Đã phê duyệt</div><div class="metric-value">@approved <small>chính thức</small></div></div>
    <div class="metric-card surface"><span class="metric-icon"><svg><use href="#i-user"/></svg></span><div class="metric-label">Đã từ chối</div><div class="metric-value">@rejected <small>không đạt</small></div></div>
</section>
<form method="get" class="surface filter-card"><div class="row g-2"><div class="col-lg-4"><input name="q" value="@ViewBag.Query" class="form-control" placeholder="Tìm theo họ tên, MSSV hoặc email"/></div>@if(User.IsInRole(AppRoles.Admin)){<div class="col-lg-3"><select name="clubId" asp-items="ViewBag.Clubs" class="form-select"><option value="">Tất cả câu lạc bộ</option></select></div>}<div class="col-lg-2"><select name="status" class="form-select"><option value="">Mọi trạng thái</option><option value="PENDING" selected="@(ViewBag.Status=="PENDING")">Chờ duyệt</option><option value="APPROVED" selected="@(ViewBag.Status=="APPROVED")">Đã duyệt</option><option value="REJECTED" selected="@(ViewBag.Status=="REJECTED")">Đã từ chối</option></select></div><div class="col-lg-2"><select name="sort" class="form-select"><option value="newest">Mới nhất</option><option value="name">Tên A-Z</option></select></div><div class="col"><button class="btn btn-primary w-100">Lọc</button></div></div></form>
<section class="table-shell"><div class="section-heading"><div><h2>Danh sách nộp đơn</h2><p>@total hồ sơ phù hợp</p></div></div><div class="table-responsive"><table class="table table-hover"><thead><tr><th>Ứng viên</th><th>Câu lạc bộ</th><th>MSSV &amp; lớp</th><th>Ngày nộp</th><th>Trạng thái</th><th>Hành động</th></tr></thead><tbody>
@foreach (var x in Model)
{
    var badge = x.Status == "APPROVED" ? "success" : x.Status == "REJECTED" ? "danger" : "warning";
    <tr><td><strong>@x.FullName</strong><br/><small class="text-muted">@x.Email</small><details class="mt-2"><summary>Thông tin đăng ký</summary><dl><dt>Năm sinh</dt><dd>@x.BirthYear</dd><dt>Sở thích</dt><dd style="white-space:pre-wrap">@x.Interests</dd><dt>Lý do chọn câu lạc bộ</dt><dd style="white-space:pre-wrap">@x.JoinReason</dd><dt>Mong muốn khi vào câu lạc bộ</dt><dd style="white-space:pre-wrap">@x.Expectations</dd></dl></details></td><td>@x.Club.ClubName</td><td><strong>@x.StudentCode</strong><br/><small class="text-muted">@x.ClassName · @x.Course</small></td><td>@x.AppliedAt.ToLocalTime().ToString("dd/MM/yyyy")</td><td><span class="status-badge @badge">@x.Status</span></td><td>@if(x.Status == "PENDING"){<div class="d-flex flex-wrap gap-2"><form asp-action="Approve" method="post"><input type="hidden" name="id" value="@x.Id"/><button class="btn btn-primary btn-sm">Duyệt đơn</button></form><form asp-action="Reject" method="post" class="d-flex gap-1"><input type="hidden" name="id" value="@x.Id"/><input name="reason" required placeholder="Lý do từ chối" class="form-control form-control-sm"/><button class="btn btn-outline-danger btn-sm">Từ chối</button></form></div>}else if(x.Status == DomainStatus.Approved){<a asp-action="IssueAccount" asp-route-id="@x.Id" class="btn btn-outline-primary btn-sm">Cấp / xem tài khoản</a>}else{<span class="text-muted small">Đã xử lý</span>}</td></tr>
}
</tbody></table></div>@if(!Model.Any()){<div class="empty-state">Không có đơn đăng ký phù hợp.</div>}</section>
