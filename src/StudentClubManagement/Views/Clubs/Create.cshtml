@model StudentClubManagement.ViewModels.ClubFormViewModel
@{ ViewData["Title"] = "Thêm câu lạc bộ"; }
<header class="page-header"><div><div class="page-eyebrow">Dành cho Admin</div><h1 class="page-title">Thêm câu lạc bộ</h1><p class="page-subtitle">Tạo một câu lạc bộ mới trong hệ thống.</p></div></header>
<form method="post" class="surface card-body col-xl-8"><div asp-validation-summary="All" class="text-danger"></div><div class="mb-3"><label asp-for="ClubName" class="form-label"></label><input asp-for="ClubName" class="form-control"/><span asp-validation-for="ClubName" class="text-danger"></span></div><div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="5"></textarea></div><div class="d-flex gap-2"><button class="btn btn-primary">Lưu câu lạc bộ</button><a class="btn btn-light" asp-action="Index">Hủy</a></div></form>
