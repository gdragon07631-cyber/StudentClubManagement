@model StudentClubManagement.ViewModels.ReportViewModel
<h1>Thống kê và báo cáo</h1><div class="row g-3">@foreach(var x in new[]{("Thành viên",Model.Members.ToString()),("Câu lạc bộ",Model.Clubs.ToString()),("Hoạt động",Model.Activities.ToString()),("Nhiệm vụ",Model.Tasks.ToString()),("Tổng điểm",Model.TotalPoints.ToString("N0")),("Tổng thu",Model.Income.ToString("N0")),("Tổng chi",Model.Expense.ToString("N0"))}){<div class="col-md-4"><div class="card card-body"><div class="text-muted">@x.Item1</div><div class="h2">@x.Item2</div></div></div>}</div><div class="mt-4"><h2 class="h4">Biểu đồ tổng hợp</h2><div class="progress mb-2" style="height:30px"><div class="progress-bar" style="width:@Math.Min(100,Model.Members)%">Thành viên @Model.Members</div></div><div class="progress" style="height:30px"><div class="progress-bar bg-success" style="width:@Math.Min(100,Model.Activities*10)%">Hoạt động @Model.Activities</div></div></div>
