@model IEnumerable<StudentClubManagement.Models.FinancialTransaction>
<h1>Tài chính</h1><div class="alert alert-primary"><strong>Số dư:</strong> @(((decimal)ViewBag.Balance).ToString("N0")) đ</div><form method="get" class="card card-body mb-3"><div class="row g-2"><div class="col"><input type="date" name="from" class="form-control"/></div><div class="col"><input type="date" name="to" class="form-control"/></div><div class="col"><select name="type" class="form-select"><option value="">Thu và chi</option><option value="INCOME">Thu</option><option value="EXPENSE">Chi</option></select></div><div class="col"><select name="sort" class="form-select"><option value="newest">Ngày mới nhất</option><option value="amount">Số tiền lớn nhất</option></select></div><div class="col"><button class="btn btn-outline-primary">Lọc báo cáo</button></div></div></form><details class="card card-body mb-3"><summary>Ghi nhận giao dịch</summary><form asp-action="Create" method="post" class="row g-2 mt-2"><div class="col-md-2"><select name="TransactionType" class="form-select"><option>INCOME</option><option>EXPENSE</option></select></div><div class="col-md-2"><input name="Category" required class="form-control" placeholder="Danh mục"/></div><div class="col-md-2"><input name="Amount" type="number" min="0.01" step="0.01" required class="form-control" placeholder="Số tiền"/></div><div class="col-md-2"><input name="TransactionDate" type="date" required class="form-control"/></div><div class="col-md-3"><input name="Description" class="form-control" placeholder="Mô tả"/></div><div class="col"><button class="btn btn-primary">Lưu</button></div></form></details><table class="table"><thead><tr><th>Ngày</th><th>Loại</th><th>Danh mục</th><th>Mô tả</th><th class="text-end">Số tiền</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.TransactionDate.ToString("dd/MM/yyyy")</td><td>@x.TransactionType</td><td>@x.Category</td><td>@x.Description</td><td class="text-end">@x.Amount.ToString("N0") đ</td></tr>}</tbody></table>
