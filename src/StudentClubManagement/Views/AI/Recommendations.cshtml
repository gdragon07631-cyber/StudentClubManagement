@model IReadOnlyList<StudentClubManagement.Services.AiRecommendation>
<h1>AI gợi ý phân công</h1><div class="alert alert-warning">AI không tự phân công. Người quản lý phải đọc lý do và bấm “Chấp nhận phân công”.</div><table class="table"><thead><tr><th>Thành viên</th><th>Phù hợp</th><th>Lý do</th><th>Quyết định</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.MemberName (#@x.MemberId)</td><td>@x.Suitability%</td><td>@x.Reason</td><td><form asp-controller="ClubTasks" asp-action="Assign" method="post"><input type="hidden" name="id" value="@ViewBag.TaskId"/><input type="hidden" name="memberId" value="@x.MemberId"/><button class="btn btn-sm btn-success">Chấp nhận phân công</button></form></td></tr>}</tbody></table><a class="btn btn-outline-secondary" asp-controller="ClubTasks">Từ chối và quay lại</a>
