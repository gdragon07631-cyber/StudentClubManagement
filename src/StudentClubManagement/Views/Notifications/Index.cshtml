@model IEnumerable<StudentClubManagement.Models.Notification>
@{ ViewData["Title"] = "Thông báo"; }
<header class="page-header"><div><div class="page-eyebrow">Hộp thư CLB</div><h1 class="page-title">Thông báo</h1><p class="page-subtitle">Các thông tin mới nhất gửi tới tài khoản của bạn.</p></div></header>
<section class="surface section-card"><div class="section-heading"><div><h2>Danh sách thông báo</h2><p>@Model.Count(x => !x.IsRead) thông báo chưa đọc</p></div></div><div class="notification-list">@foreach(var x in Model){<article class="notification-item"><span class="notification-dot" style="opacity:@(x.IsRead?".25":"1")"></span><div class="flex-grow-1"><div class="d-flex justify-content-between gap-3"><strong>@x.Title</strong><small class="text-muted">@x.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")</small></div><p class="mt-1">@x.Content</p>@if(!x.IsRead){<form asp-action="Read" method="post" class="mt-2"><input type="hidden" name="id" value="@x.Id"/><button class="btn btn-sm btn-light">Đánh dấu đã đọc</button></form>}</div></article>}</div>@if(!Model.Any()){<div class="empty-state">Chưa có thông báo.</div>}</section>
