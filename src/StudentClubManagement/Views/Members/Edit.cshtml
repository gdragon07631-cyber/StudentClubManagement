@using StudentClubManagement.Models
@model StudentClubManagement.ViewModels.MemberEditViewModel
<h1>Cập nhật hồ sơ thành viên</h1><form method="post" class="card card-body"><input asp-for="Id" type="hidden"/><div asp-validation-summary="All" class="text-danger"></div><div class="row g-3"><div class="col-md-6"><label asp-for="FullName"></label><input asp-for="FullName" class="form-control"/></div><div class="col-md-6"><label asp-for="Email"></label><input asp-for="Email" class="form-control"/></div><div class="col-md-4"><label asp-for="Phone"></label><input asp-for="Phone" class="form-control"/></div><div class="col-md-4"><label asp-for="ClassName"></label><input asp-for="ClassName" class="form-control"/></div><div class="col-md-4"><label asp-for="Course"></label><input asp-for="Course" class="form-control"/></div>@if(!User.IsInRole(AppRoles.Member)){<div class="col-md-6"><label asp-for="Position"></label><input asp-for="Position" class="form-control"/></div>}@if(User.IsInRole(AppRoles.Admin)){<div class="col-md-4"><label asp-for="ClubId"></label><select asp-for="ClubId" asp-items="ViewBag.Clubs" class="form-select"></select></div><div class="col-md-4"><label asp-for="UserId"></label><select asp-for="UserId" asp-items="ViewBag.Users" class="form-select"><option value="">-- Chưa liên kết --</option></select></div><div class="col-md-4"><label asp-for="MemberStatus"></label><select asp-for="MemberStatus" class="form-select"><option value="ACTIVE">ACTIVE</option><option value="INACTIVE">INACTIVE</option></select></div>}else{<input asp-for="ClubId" type="hidden"/><input asp-for="UserId" type="hidden"/>}</div><button class="btn btn-primary mt-3">Lưu thay đổi</button></form>
