@model StudentClubManagement.Models.Member
<h1>Thêm thành viên</h1><form method="post" class="card card-body"><div asp-validation-summary="All" class="text-danger"></div><div class="row g-3"><div class="col-md-6"><label asp-for="StudentCode"></label><input asp-for="StudentCode" class="form-control"/></div><div class="col-md-6"><label asp-for="FullName"></label><input asp-for="FullName" class="form-control"/></div><div class="col-md-6"><label asp-for="Email"></label><input asp-for="Email" class="form-control"/></div><div class="col-md-6"><label asp-for="ClubId">Câu lạc bộ</label><select asp-for="ClubId" asp-items="ViewBag.Clubs" class="form-select"><option value="">-- Chọn câu lạc bộ --</option></select></div><div class="col-md-6"><label asp-for="UserId">Tài khoản đăng nhập</label><select asp-for="UserId" asp-items="ViewBag.Users" class="form-select"><option value="">-- Chưa liên kết tài khoản --</option></select><div class="form-text">Bắt buộc liên kết nếu thành viên là Trưởng câu lạc bộ.</div></div><div class="col-md-4"><label asp-for="ClassName"></label><input asp-for="ClassName" class="form-control"/></div><div class="col-md-4"><label asp-for="Course"></label><input asp-for="Course" class="form-control"/></div><div class="col-md-4"><label asp-for="Phone"></label><input asp-for="Phone" class="form-control"/></div></div><button class="btn btn-primary mt-3">Lưu</button></form>
