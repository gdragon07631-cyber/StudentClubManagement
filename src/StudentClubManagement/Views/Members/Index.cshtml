@using StudentClubManagement.Models
@model IEnumerable<Member>
@{ ViewData["Title"] = "Thành viên"; }
<header class="page-header"><div><div class="page-eyebrow">Nhân sự CLB</div><h1 class="page-title">@(User.IsInRole(AppRoles.Member) ? "Hồ sơ của tôi" : User.IsInRole(AppRoles.ClubLeader) ? "Thành viên câu lạc bộ" : "Quản lý thành viên")</h1><p class="page-subtitle">Danh sách được giới hạn tự động theo vai trò và câu lạc bộ của tài khoản.</p></div>@if(User.IsInRole(AppRoles.Admin)){<div class="page-actions"><a class="btn btn-primary btn-icon" asp-action="Create"><svg><use href="#i-plus"/></svg>Thêm thành viên</a></div>}</header>
<form method="get" class="surface filter-card"><div class="row g-2"><div class="col-lg-4"><input name="q" value="@ViewBag.Query" class="form-control" placeholder="Tìm tên hoặc MSSV"/></div>@if(User.IsInRole(AppRoles.Admin)){<div class="col-lg-3"><select name="clubId" asp-items="ViewBag.Clubs" class="form-select"><option value="">Tất cả câu lạc bộ</option></select></div>}<div class="col-lg-2"><select name="status" class="form-select"><option value="">Mọi trạng thái</option><option value="ACTIVE" selected="@(ViewBag.Status=="ACTIVE")">Đang hoạt động</option><option value="INACTIVE" selected="@(ViewBag.Status=="INACTIVE")">Ngừng hoạt động</option></select></div><div class="col-lg-2"><select name="sort" class="form-select"><option value="name">Tên A-Z</option><option value="studentCode" selected="@(ViewBag.Sort=="studentCode")">Theo MSSV</option><option value="newest" selected="@(ViewBag.Sort=="newest")">Mới tham gia</option></select></div><div class="col"><button class="btn btn-primary w-100">Lọc</button></div></div></form>
<section class="table-shell"><div class="section-heading"><div><h2>Danh sách thành viên</h2><p>@Model.Count() hồ sơ phù hợp</p></div></div><div class="table-responsive"><table class="table table-hover"><thead><tr><th>Thành viên</th><th>MSSV</th><th>Câu lạc bộ</th><th>Lớp</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>@foreach(var x in Model){<tr><td><strong>@x.FullName</strong><br/><small class="text-muted">@x.Email</small></td><td><a asp-action="Details" asp-route-id="@x.Id"><strong>@x.StudentCode</strong></a></td><td>@x.Club?.ClubName</td><td>@x.ClassName</td><td><span class="status-badge @(x.MemberStatus=="ACTIVE"?"success":"warning")">@x.MemberStatus</span></td><td><div class="d-flex flex-wrap gap-2"><a class="btn btn-sm btn-light" asp-action="Details" asp-route-id="@x.Id">Chi tiết</a><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@x.Id">Sửa</a>@if(!User.IsInRole(AppRoles.Member)){<form asp-controller="AI" asp-action="Participation" method="post" class="d-inline"><input type="hidden" name="memberId" value="@x.Id"/><button class="btn btn-sm btn-outline-primary" title="AI đánh giá tham gia">AI đánh giá</button></form>}@if(User.IsInRole(AppRoles.Admin)){<form asp-action="SetStatus" method="post"><input type="hidden" name="id" value="@x.Id"/><input type="hidden" name="status" value="@(x.MemberStatus=="ACTIVE"?"INACTIVE":"ACTIVE")"/><button class="btn btn-sm btn-light" onclick="return confirm('Xác nhận đổi trạng thái thành viên?')">Đổi trạng thái</button></form>}</div></td></tr>}</tbody></table></div>@if(!Model.Any()){<div class="empty-state">Không có thành viên phù hợp bộ lọc.</div>}</section>
