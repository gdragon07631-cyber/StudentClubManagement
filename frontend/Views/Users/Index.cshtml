@using StudentClubManagement.Models
@model IEnumerable<ApplicationUser>
@{ var currentRoles = (Dictionary<int, string>)ViewBag.CurrentRoles; var members = (List<Member>)ViewBag.Members; }
<div class="d-flex justify-content-between"><h1>Tài khoản và phân quyền</h1><a class="btn btn-primary" asp-action="Create">Tạo tài khoản</a></div><p class="text-muted mt-3">Khi cấp quyền Trưởng câu lạc bộ, chọn hồ sơ thành viên thuộc CLB được quản lý. Người dùng đăng nhập lại sau khi đổi quyền.</p><table class="table mt-3"><thead><tr><th>Username</th><th>Email</th><th>Trạng thái</th><th>Đặt vai trò</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.UserName</td><td>@x.Email</td><td><span class="badge @(x.Status=="ACTIVE"?"bg-success":"bg-secondary")">@x.Status</span></td><td><form asp-action="SetRole" method="post" class="d-flex gap-2"><input type="hidden" name="id" value="@x.Id"/><select name="role" class="form-select form-select-sm"><option value="" disabled selected="@(currentRoles[x.Id] == "")">Chưa có vai trò</option><option value="ADMIN" selected="@(currentRoles[x.Id] == AppRoles.Admin)">Admin</option><option value="CLUB_LEADER" selected="@(currentRoles[x.Id] == AppRoles.ClubLeader)">Trưởng câu lạc bộ</option><option value="MEMBER" selected="@(currentRoles[x.Id] == AppRoles.Member)">Thành viên</option></select><select name="memberId" class="form-select form-select-sm" aria-label="Hồ sơ và câu lạc bộ quản lý">
<option value="">-- Chọn hồ sơ / CLB --</option>
@foreach (var member in members.Where(m => m.UserId == x.Id || m.UserId == null))
{
<option value="@member.Id" selected="@(member.UserId == x.Id)">@member.FullName (@member.StudentCode) — @member.Club.ClubName</option>
}
</select><button class="btn btn-sm btn-primary">Lưu</button></form></td><td><form asp-action="ToggleStatus" method="post"><input type="hidden" name="id" value="@x.Id"/><button class="btn btn-sm btn-outline-secondary" onclick="return confirm('Xác nhận đổi trạng thái tài khoản?')">Khóa/Mở</button></form></td></tr>}</tbody></table>
