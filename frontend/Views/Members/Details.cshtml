@using StudentClubManagement.Models
@model StudentClubManagement.Models.Member
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>@Model.FullName</h1>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">Cập nhật hồ sơ</a>
        @if(!User.IsInRole(AppRoles.Member)){
            <form asp-controller="AI" asp-action="Participation" method="post" class="d-inline">
                <input type="hidden" name="memberId" value="@Model.Id" />
                <button class="btn btn-primary btn-icon"><svg><use href="#i-spark"/></svg>AI đánh giá tham gia</button>
            </form>
        }
    </div>
</div>
<div class="card card-body"><dl class="row mb-0"><dt class="col-sm-3">MSSV</dt><dd class="col-sm-9">@Model.StudentCode</dd><dt class="col-sm-3">Email</dt><dd class="col-sm-9">@Model.Email</dd><dt class="col-sm-3">Điện thoại</dt><dd class="col-sm-9">@Model.Phone</dd><dt class="col-sm-3">Lớp / khóa</dt><dd class="col-sm-9">@Model.ClassName / @Model.Course</dd><dt class="col-sm-3">Câu lạc bộ</dt><dd class="col-sm-9">@Model.Club?.ClubName</dd><dt class="col-sm-3">Kỹ năng</dt><dd class="col-sm-9">@string.Join(", ",Model.Skills.Select(x=>x.SkillName))</dd></dl></div>

