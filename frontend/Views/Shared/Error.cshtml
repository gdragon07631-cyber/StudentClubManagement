@model ErrorViewModel
@{ ViewData["Title"] = "Có lỗi xảy ra"; }
<div class="card card-body text-center py-5"><h1 class="text-danger">Không thể hoàn tất yêu cầu</h1><p>Hệ thống đã ghi nhận lỗi. Dữ liệu của bạn không bị thay đổi; vui lòng thử lại hoặc liên hệ quản trị viên.</p>@if(Model.ShowRequestId){<p class="text-muted">Mã tra cứu: <code>@Model.RequestId</code></p>}<a class="btn btn-primary mx-auto" asp-controller="Dashboard" asp-action="Index">Về trang tổng quan</a></div>
