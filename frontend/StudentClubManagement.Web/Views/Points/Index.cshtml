@using StudentClubManagement.Models
@using StudentClubManagement.ViewModels
@model PointIndexResponse
@{
    ViewData["Title"] = "Điểm hoạt động";
    var activeMembers = Model.ActiveMembers;
    var rules = Model.Rules;
}
<header class="page-header">
    <div>
        <div class="page-eyebrow">Đánh giá &amp; Khen thưởng</div>
        <h1 class="page-title">Lịch sử điểm hoạt động</h1>
        <p class="page-subtitle">Điểm luôn được lưu theo lịch sử và nguồn; dữ liệu demo không phải công thức điểm chính thức.</p>
    </div>
</header>
<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="alert alert-info py-2 px-3 mb-0 flex-grow-1 me-3">
        Tổng số: <strong>@Model.Items.Count()</strong> bản ghi điểm | Tổng tích lũy: <strong>@Model.Items.Sum(x => x.Points).ToString("N0")</strong> điểm
    </div>
    <form method="get" class="d-flex gap-2">
        <select name="sort" class="form-select form-select-sm" onchange="this.form.submit()">
            <option value="newest" selected="@(ViewBag.Sort=="newest")">Mới nhất</option>
            <option value="points" selected="@(ViewBag.Sort=="points")">Điểm cao nhất</option>
        </select>
    </form>
</div>
@if(User.IsInRole(AppRoles.Admin)){
    <details class="card card-body mb-3">
        <summary class="fw-bold text-primary" style="cursor:pointer">Ghi nhận điểm hoạt động mới</summary>
        <form asp-action="Record" method="post" class="row g-2 mt-2">
            <div class="col-md-4">
                <label class="form-label small">Thành viên</label>
                <select name="MemberId" class="form-select form-select-sm" required>
                    <option value="">-- Chọn thành viên --</option>
                    @foreach(var m in activeMembers){
                        <option value="@m.Id">@m.FullName (@m.StudentCode) - @m.ClubName</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small">Quy tắc điểm</label>
                <select name="PointRuleId" class="form-select form-select-sm" required>
                    <option value="">-- Chọn quy tắc --</option>
                    @foreach(var r in rules){
                        <option value="@r.Id">@r.RuleName (@r.PointValue đ)</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small">Nguồn</label>
                <input name="SourceType" value="MANUAL" required class="form-control form-control-sm" placeholder="VD: MANUAL" />
            </div>
            <input type="hidden" name="SourceId" value="0" />
            <div class="col-md-3">
                <label class="form-label small">Số điểm</label>
                <input name="Points" type="number" step="0.5" required class="form-control form-control-sm" placeholder="Số điểm" />
            </div>
            <div class="col-md-10">
                <label class="form-label small">Lý do ghi điểm</label>
                <input name="Reason" required class="form-control form-control-sm" placeholder="Nhập lý do ghi nhận điểm thưởng/phạt..." />
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button class="btn btn-sm btn-primary w-100">Ghi nhận</button>
            </div>
        </form>
    </details>
}
<div class="table-shell">
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Thành viên</th>
                    <th>Quy tắc</th>
                    <th>Nguồn</th>
                    <th>Điểm</th>
                    <th>Lý do</th>
                    <th>Thời gian</th>
                </tr>
            </thead>
            <tbody>
            @foreach(var x in Model.Items){
                <tr>
                    <td><strong>@x.Member.FullName</strong><br/><small class="text-muted">@x.Member.StudentCode</small></td>
                    <td>@x.PointRule.RuleName</td>
                    <td><span class="badge bg-light text-dark">@x.SourceType #@x.SourceId</span></td>
                    <td><strong class="@(x.Points >= 0 ? "text-success" : "text-danger")">@(x.Points > 0 ? "+" : "")@x.Points.ToString("N1")</strong></td>
                    <td>@x.Reason</td>
                    <td>@x.RecordedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    @if(!Model.Items.Any()){
        <div class="empty-state">Chưa có lịch sử điểm hoạt động nào.</div>
    }
</div>

