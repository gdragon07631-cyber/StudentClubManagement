@{ ViewData["Title"] = "Không thể truy cập"; }
<div class="card card-body text-center py-5"><h1>@ViewBag.StatusCode</h1><p>@if(ViewBag.StatusCode==404){<span>Không tìm thấy trang hoặc dữ liệu bạn yêu cầu.</span>}else if(ViewBag.StatusCode==403){<span>Bạn không có quyền truy cập nội dung này.</span>}else{<span>Yêu cầu không thể được xử lý.</span>}</p><a class="btn btn-primary mx-auto" asp-controller="Dashboard" asp-action="Index">Về trang tổng quan</a></div>
