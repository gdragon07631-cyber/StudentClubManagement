@using StudentClubManagement.Models
@using StudentClubManagement.ViewModels
@using StudentClubManagement.ViewModels
@model IEnumerable<ActivityCard>
@{ ViewData["Title"] = "Sự kiện & Hoạt động"; }
<header class="page-header"><div><div class="page-eyebrow">Lịch CLB</div><h1 class="page-title">Sự kiện &amp; Hoạt động</h1><p class="page-subtitle">Theo dõi lịch trình, địa điểm, trạng thái và thao tác đăng ký theo quyền hiện có.</p></div>@if(!User.IsInRole(AppRoles.Member)){<div class="page-actions"><a class="btn btn-primary btn-icon" asp-action="Create"><svg><use href="#i-plus"/></svg>Tạo hoạt động</a></div>}</header>
<form method="get" class="surface filter-card"><div class="row g-2"><div class="col-lg-5"><input name="q" value="@ViewBag.Query" class="form-control" placeholder="Tên hoạt động hoặc địa điểm"/></div><div class="col-lg-3"><select name="status" class="form-select"><option value="">Mọi trạng thái</option><option value="PLANNED" selected="@(ViewBag.Status=="PLANNED")">Sắp diễn ra</option><option value="CANCELLED" selected="@(ViewBag.Status=="CANCELLED")">Đã hủy</option><option value="COMPLETED" selected="@(ViewBag.Status=="COMPLETED")">Hoàn thành</option></select></div><div class="col-lg-2"><select name="sort" class="form-select"><option value="newest">Mới nhất</option><option value="name" selected="@(ViewBag.Sort=="name")">Tên A-Z</option></select></div><div class="col"><button class="btn btn-primary w-100">Lọc</button></div></div></form>
<div class="row g-4">
@foreach(var card in Model){
    var x = card.Activity;
    var badge = x.Status=="COMPLETED" ? "success" : x.Status=="CANCELLED" ? "danger" : "primary";
    var attendances = card.Attendances;


    var unrecorded = card.Unrecorded;
    <div class="col-md-6">
        <article class="surface h-100 p-4">
            <div class="d-flex justify-content-between gap-3">
                <span class="metric-icon"><svg><use href="#i-calendar"/></svg></span>
                <span class="status-badge @badge">@x.Status</span>
            </div>
            <h2 class="h4 mt-3">@x.ActivityName</h2>
            <p class="text-muted">@(x.Description ?? "Chưa có mô tả.")</p>
            <div class="calendar-item success mt-3">
                <strong>@x.StartTime.ToString("dd/MM/yyyy HH:mm")</strong>
                <p class="mt-1">@(x.Location ?? "Chưa có địa điểm") · Kết thúc @x.EndTime.ToString("HH:mm")</p>
            </div>
            <div class="d-flex flex-wrap gap-2 mt-3">
                @if(User.IsInRole(AppRoles.Member)&&x.Status!="CANCELLED"){
                    <form asp-action="Register" method="post"><input type="hidden" name="id" value="@x.Id"/><button class="btn btn-primary btn-sm">Đăng ký</button></form>
                    <form asp-action="Cancel" method="post"><input type="hidden" name="id" value="@x.Id"/><button class="btn btn-light btn-sm">Hủy đăng ký</button></form>
                }
                @if(!User.IsInRole(AppRoles.Member)){
                    <a class="btn btn-light btn-sm" asp-action="Edit" asp-route-id="@x.Id">Chỉnh sửa</a>
                    @if(x.Status!="CANCELLED"){
                        <form asp-action="CancelActivity" method="post"><input type="hidden" name="id" value="@x.Id"/><button class="btn btn-outline-danger btn-sm" onclick="return confirm('Xác nhận hủy hoạt động?')">Hủy hoạt động</button></form>
                    }
                }
            </div>
            @if(!User.IsInRole(AppRoles.Member)){
                <details class="mt-3 pt-2 border-top">
                    <summary class="text-primary small" style="cursor:pointer; font-weight:600;">Điểm danh thành viên (@attendances.Count đã ghi)</summary>
                    @if(unrecorded.Any() && x.Status != "CANCELLED"){
                        <form asp-action="Attendance" method="post" class="d-flex flex-wrap gap-2 mt-2 align-items-center">
                            <input type="hidden" name="id" value="@x.Id" />
                            <select name="memberId" class="form-select form-select-sm" style="max-width:200px" required>
                                <option value="">-- Chọn thành viên --</option>
                                @foreach(var m in unrecorded){
                                    <option value="@m.Id">@m.FullName (@m.StudentCode)</option>
                                }
                            </select>
                            <select name="status" class="form-select form-select-sm" style="max-width:120px" required>
                                <option value="PRESENT">Có mặt</option>
                                <option value="LATE">Đi muộn</option>
                                <option value="ABSENT">Vắng mặt</option>
                            </select>
                            <button class="btn btn-sm btn-primary">Điểm danh</button>
                        </form>
                    }
                    @if(attendances.Any()){
                        <div class="small mt-2">
                            <ul class="list-unstyled mb-0">
                                @foreach(var att in attendances){
                                    var attBadge = att.AttendanceStatus == "PRESENT" ? "success" : att.AttendanceStatus == "LATE" ? "warning" : "danger";
                                    var attText = att.AttendanceStatus == "PRESENT" ? "Có mặt" : att.AttendanceStatus == "LATE" ? "Đi muộn" : "Vắng";
                                    <li class="d-flex justify-content-between py-1 border-bottom">
                                        <span>@att.Member.FullName (@att.Member.StudentCode)</span>
                                        <span class="status-badge @attBadge">@attText</span>
                                    </li>
                                }
                            </ul>
                        </div>
                    }else{
                        <p class="text-muted small mt-2 mb-0">Chưa có bản ghi điểm danh nào.</p>
                    }
                </details>
            }
        </article>
    </div>
}
</div>
@if(!Model.Any()){<div class="surface empty-state">Không có hoạt động phù hợp.</div>}

