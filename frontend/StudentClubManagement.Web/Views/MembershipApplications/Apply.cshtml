@model StudentClubManagement.ViewModels.MembershipApplicationViewModel
<h1>Đăng ký tham gia câu lạc bộ</h1><form method="post" class="card card-body"><div asp-validation-summary="All" class="text-danger"></div><div class="row g-3"><div class="col-12"><label asp-for="ClubId"></label><select asp-for="ClubId" asp-items="ViewBag.Clubs" class="form-select"><option value="">-- Chọn câu lạc bộ --</option></select></div><div class="col-md-6"><label asp-for="StudentCode"></label><input asp-for="StudentCode" class="form-control"/></div><div class="col-md-6"><label asp-for="FullName"></label><input asp-for="FullName" class="form-control"/></div><div class="col-md-6"><label asp-for="Email"></label><input asp-for="Email" class="form-control"/></div><div class="col-md-6"><label asp-for="Phone"></label><input asp-for="Phone" class="form-control"/></div><div class="col-md-6"><label asp-for="ClassName"></label><input asp-for="ClassName" class="form-control"/></div><div class="col-md-6"><label asp-for="Course"></label><input asp-for="Course" class="form-control"/></div><div class="col-md-6"><label asp-for="BirthYear"></label><input asp-for="BirthYear" type="number" min="1900" max="@DateTime.Today.Year" class="form-control" /></div><div class="col-12"><label asp-for="Interests"></label><textarea asp-for="Interests" class="form-control" rows="3" maxlength="1000"></textarea></div><div class="col-12"><label asp-for="JoinReason"></label><textarea asp-for="JoinReason" class="form-control" rows="3" maxlength="2000"></textarea></div><div class="col-12"><label asp-for="Expectations"></label><textarea asp-for="Expectations" class="form-control" rows="3" maxlength="2000"></textarea></div></div><button class="btn btn-primary mt-3">Gửi đăng ký</button></form>
