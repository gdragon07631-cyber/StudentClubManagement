@model StudentClubManagement.ViewModels.DashboardViewModel
@{ ViewData["Title"] = "Tổng quan quản trị"; }
<header class="page-header">
    <div><div class="page-eyebrow">Campus Executive Hub</div><h1 class="page-title">Quản lý câu lạc bộ &amp; điều hành</h1><p class="page-subtitle">Theo dõi cơ cấu, thành viên, hoạt động và nhiệm vụ từ dữ liệu vận hành thực tế.</p></div>
    <div class="page-actions"><a class="btn btn-light btn-icon" asp-controller="Reports"><svg><use href="#i-chart"/></svg>Xem báo cáo</a><a class="btn btn-primary btn-icon" asp-controller="Clubs" asp-action="Create"><svg><use href="#i-plus"/></svg>Thêm câu lạc bộ</a></div>
</header>
<section class="metric-grid">
    <a class="metric-card surface" asp-controller="Clubs"><span class="metric-icon"><svg><use href="#i-building"/></svg></span><div class="metric-label">Câu lạc bộ</div><div class="metric-value">@Model.Clubs <small>câu lạc bộ</small></div><div class="metric-note">Toàn bộ câu lạc bộ trong hệ thống</div></a>
    <a class="metric-card surface" asp-controller="Members"><span class="metric-icon"><svg><use href="#i-users"/></svg></span><div class="metric-label">Nhân sự hiện diện</div><div class="metric-value">@Model.Members <small>thành viên</small></div><div class="metric-note success">Dữ liệu hồ sơ đang quản lý</div></a>
    <a class="metric-card surface" asp-controller="ClubTasks"><span class="metric-icon"><svg><use href="#i-clipboard"/></svg></span><div class="metric-label">Công việc chưa hoàn tất</div><div class="metric-value">@Model.OpenTasks <small>nhiệm vụ</small></div><div class="metric-note">Tiến độ dưới 100%</div></a>
    <a class="metric-card surface" asp-controller="Activities"><span class="metric-icon"><svg><use href="#i-calendar"/></svg></span><div class="metric-label">Sự kiện &amp; hoạt động</div><div class="metric-value">@Model.Activities <small>hoạt động</small></div><div class="metric-note">Tất cả trạng thái trong hệ thống</div></a>
</section>

<section class="surface section-card mb-4">
    <div class="section-heading"><div><h2>Danh sách câu lạc bộ</h2><p>Số thành viên được lấy trực tiếp từ dữ liệu hiện tại.</p></div><a class="section-link" asp-controller="Clubs">Xem tất cả →</a></div>
    @if (Model.ClubItems.Any())
    {
        <div class="department-grid p-3">
        @foreach (var club in Model.ClubItems)
        {
            <article class="department-card surface"><span class="metric-icon"><svg><use href="#i-building"/></svg></span><h3>@club.ClubName</h3><p>@(club.Description ?? "Chưa có mô tả cho câu lạc bộ này.")</p><div class="department-stats"><span><span>Thành viên</span><strong>@club.MemberCount người</strong></span></div><div class="d-flex gap-2 mt-3"><a class="btn btn-light btn-sm flex-fill" asp-controller="Members" asp-route-clubId="@club.Id">Chi tiết</a><a class="btn btn-primary btn-sm flex-fill" asp-controller="Clubs" asp-action="Edit" asp-route-id="@club.Id">Cập nhật</a></div></article>
        }
        </div>
    }
    else { <div class="empty-state">Chưa có câu lạc bộ.</div> }
</section>

<div class="dashboard-grid">
    <section class="surface section-card">
        <div class="section-heading"><div><h2>Hoạt động &amp; lịch họp sắp tới</h2><p>Lịch gần nhất của câu lạc bộ.</p></div></div>
        <div class="calendar-list">
            @foreach (var activity in Model.UpcomingActivities) { <article class="calendar-item success"><span class="status-badge success">Hoạt động</span><h3>@activity.ActivityName</h3><p>@activity.StartTime.ToString("dd/MM/yyyy HH:mm") · @(activity.Location ?? "Chưa có địa điểm")</p></article> }
            @foreach (var meeting in Model.UpcomingMeetings) { <article class="calendar-item"><span class="status-badge primary">Cuộc họp</span><h3>@meeting.Title</h3><p>@meeting.MeetingTime.ToString("dd/MM/yyyy HH:mm") · @(meeting.Location ?? "Chưa có địa điểm")</p></article> }
            @if (!Model.UpcomingActivities.Any() && !Model.UpcomingMeetings.Any()) { <div class="empty-state">Chưa có lịch sắp tới.</div> }
        </div>
    </section>
    <aside class="stack dashboard-aside"><section class="surface ai-panel"><h2>Trợ lý CLB AI</h2><p>Hỗ trợ tra cứu dữ liệu được phân quyền. AI chỉ gợi ý, không tự thay người quản lý ra quyết định.</p><a class="btn" asp-controller="AI" asp-action="Chat">Mở Chatbot AI</a></section><section class="surface section-card"><div class="section-heading no-border"><div><h2>Tài chính</h2><p>Số dư hiện tại</p></div></div><div class="p-4 pt-2"><div class="metric-value">@Model.Balance.ToString("N0") <small>đ</small></div><a class="section-link d-inline-block mt-3" asp-controller="Finance">Xem sổ quỹ →</a></div></section></aside>
</div>
