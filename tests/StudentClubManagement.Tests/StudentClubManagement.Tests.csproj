    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\StudentClubManagement\StudentClubManagement.csproj" ReferenceOutputAssembly="false" />
    <!-- Link the exact production sources so tests can run under the host's DLL application-control policy. -->
