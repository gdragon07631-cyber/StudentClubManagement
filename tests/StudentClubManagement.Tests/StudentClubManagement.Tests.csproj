<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\backend\StudentClubManagement.Api\StudentClubManagement.Api.csproj" ReferenceOutputAssembly="false" />
    <!-- Link the exact production sources so tests can run under the host's DLL application-control policy. -->
    <Compile Include="..\..\backend\StudentClubManagement.Core\Models\**\*.cs" Link="Production\Models\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\backend\StudentClubManagement.Core\ViewModels\**\*.cs" Link="Production\ViewModels\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\backend\StudentClubManagement.Api\Data\**\*.cs" Link="Production\Data\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\backend\StudentClubManagement.Api\Authorization\**\*.cs" Link="Production\Authorization\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\backend\StudentClubManagement.Api\Services\**\*.cs" Link="Production\Services\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>